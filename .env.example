# Copy to .env and fill in. Local dev works with just DATABASE_URL + SESSION_SECRET.
DATABASE_URL="file:./dev.db"
SESSION_SECRET="change-me-to-a-32-byte-random-hex"
APP_URL="http://localhost:3000"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RESEND_API_KEY=""
EMAIL_FROM="Opher <onboarding@resend.dev>"
CRON_SECRET="a-long-random-string"

# Publishable key for Stripe Elements in the browser. Without it the join flow
# falls back to a keyless dev path that saves a placeholder card.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
